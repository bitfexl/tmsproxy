{
  "port": 80,
  "caches": [
    {
      "name": "default-cache",
      "directory": "/tile-cache"
    }
  ],
  "tiles": [
    {
      "name": "osm",
      "cache": "default-cache",
      "sources": [
        "https://tile.openstreetmap.org/{z}/{x}/{y}.png"
      ],
      "headers": {
        "User-Agent": "tmsproxy"
      }
    },
    {
      "name": "otm",
      "cache": "default-cache",
      "sources": [
        "https://a.tile.opentopomap.org/{z}/{x}/{y}.png",
        "https://b.tile.opentopomap.org/{z}/{x}/{y}.png",
        "https://c.tile.opentopomap.org/{z}/{x}/{y}.png"
      ]
    }
  ]
}